# Cloudflare Pages reads this file from the static asset directory.
# Angular emits hashed JS/CSS filenames, so these assets can be cached long-term.

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=2592000

/*.ico
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
