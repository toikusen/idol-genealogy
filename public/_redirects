# Cloudflare Pages would otherwise 301-redirect /member/{uuid} to /member/{uuid}/
# because the static output is member/{uuid}/index.html. These 200 rewrites suppress
# that redirect so sitemap URLs (no trailing slash) are served without a redirect.
/member/:id  /member/:id/  200
/group/:id   /group/:id/   200
/company/:id /company/:id/ 200
/venue/:id   /venue/:id/   200
/learn/:slug /learn/:slug/ 200
/members     /members/     200
/about       /about/       200
/guide       /guide/       200
/learn       /learn/       200
/contact     /contact/     200
/privacy     /privacy/     200
/terms       /terms/       200
/contributors /contributors/ 200
/leaderboard /leaderboard/ 200
/wanted      /wanted/      200
# SPA routes handled by _middleware.ts via env.ASSETS
